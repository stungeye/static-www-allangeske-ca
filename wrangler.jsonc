// Cloudflare Workers static assets for www.allangeske.ca (PLAN C4, F46). See README "Hosting".
{
  "name": "static-www-allangeske-ca",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,  // until the cutover (then false, R11)
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Cutover, owner-approved 2026-10-31 once the zone moved to Cloudflare (PLAN C5). Rollback: remove this and push, or delete the route in the dashboard.
  "routes": [{ "pattern": "www.allangeske.ca/*", "zone_name": "allangeske.ca" }]
}
