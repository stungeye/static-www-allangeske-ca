// Cloudflare Workers static assets for www.allangeske.ca (PLAN C4, F46). See README "Hosting".
{
  "name": "static-www-allangeske-ca",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,  // until the cutover (then false, R11)
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
  // No route yet: allangeske.ca's DNS is still at DigitalOcean. The route comes after the zone move (PLAN C5), with the owner's yes.
}
